*.crf
*.d
*.dep
*.axf
*.hex
*.bin
*.elf
*.map
*.lnp
*.lst
*.sct
*.htm
*.build_log.htm
*.Bak
*.bak
*.uvguix.*

# Keil 的构建输出目录(以工程名命名,里面全是上面的产物)
MDK-ARM/RobotHAL/
MDK-ARM/RobotHAL_RTOS_Lab/

# Keil 自动生成的配置(每人机器不同,传了反而干扰)
MDK-ARM/DebugConfig/

