# ============================================================
#  Keil MDK 构建产物 —— 体积最大的部分(每个工程 59~67MB)
# ============================================================
*.o
*.crf
*.d
*.dep
*.axf
*.hex
*.bin
*.elf
*.map
*.lnp
*.lst
*.sct
*.htm
*.build_log.htm
*.Bak
*.bak
*.uvguix.*

# Keil 的构建输出目录(以工程名命名,里面全是上面的产物)
MCU-HAL-RTOS/MDK-ARM/TreeWhitewash_RTOS/
MCU-HAL/MDK-ARM/RobotHAL/
MCU/USER/Objects/
MCU/USER/Listings/

# Keil 自动生成的调试配置(每台机器不同,传了反而干扰)
MCU-HAL-RTOS/MDK-ARM/DebugConfig/
MCU-HAL/MDK-ARM/DebugConfig/
MCU/USER/DebugConfig/

# ============================================================
#  本地临时文件
# ============================================================
cli_build.log
*.log

# ============================================================
#  本地资料,不入库
# ============================================================
/RobotHAL_RTOS/
/主控代码/
/*.docx
/*.HMI
